<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="eg.mts.gsuif.logging.MaskingPatternLayout">
                    <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{correlationId:-NO_CORR_ID}] %cyan(%logger{36}) - %msg%n</pattern>
                </layout>
            </encoder>
        </appender>

        <logger name="eg.mts.gsuif" level="DEBUG" />

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="eg.mts.gsuif.logging.MaskingPatternLayout">
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{correlationId:-NO_CORR_ID}] %logger{36} - %msg%n</pattern>
                </layout>
            </encoder>
        </appender>

        <logger name="eg.mts.gsuif" level="INFO" />

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>
