<#ftl strip_whitespace=true encoding="UTF-8">
${entitySql}
CREATE TABLE user_accounts (
    id uuid NOT NULL,
    username varchar(100) NOT NULL,
    password_hash varchar(255) NOT NULL,
    enabled boolean NOT NULL,
    CONSTRAINT pk_user_accounts PRIMARY KEY (id),
    CONSTRAINT uq_user_accounts_username UNIQUE (username)
);

CREATE TABLE user_account_roles (
    user_id uuid NOT NULL,
    role varchar(32) NOT NULL,
    CONSTRAINT pk_user_account_roles PRIMARY KEY (user_id, role),
    CONSTRAINT ck_user_account_roles_role CHECK (role IN ('ROLE_ADMIN', 'ROLE_USER')),
    CONSTRAINT fk_user_account_roles_user FOREIGN KEY (user_id) REFERENCES user_accounts(id) ON DELETE RESTRICT
);
<#if audited>

CREATE TABLE app_revision (
    rev bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    revtstmp bigint NOT NULL,
    CONSTRAINT pk_app_revision PRIMARY KEY (rev)
);

CREATE TABLE ${auditTable} (
<#list auditColumns as column>    ${column.name} ${column.sqlType}<#if column.name == 'id'> NOT NULL</#if>,
</#list>    rev bigint NOT NULL,
    revtype smallint NOT NULL,
    CONSTRAINT pk_${auditTable} PRIMARY KEY (id, rev),
    CONSTRAINT fk_${auditTable}_rev FOREIGN KEY (rev) REFERENCES app_revision(rev) ON DELETE RESTRICT<#list auditChecks as check>,
    CONSTRAINT ${check.name} CHECK (${check.column} IS NULL OR ${check.column} IN (<#list check.enumValues as value>'${value}'<#sep>, </#list>))</#list>
);
</#if>
